        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();\npm.environment.set(\"b_ID\", jsonData.bookingid);\n\npm.test(\"Verify the status code\" ,()=>{\n    pm.response.to.have.status(200);\n    console.log(\"Verified!\")\n});\npm.test(\"Verify response time\",()=>{\n    const responseTime = pm.response.responseTime;\n    pm.expect(responseTime).to.be.below(5000);\n    console.log(responseTime);\n});\npm.test(\"Verify Content-type header validation\",()=>{\n    pm.response.to.have.header(\"Content-Type\");\n    const contentType = pm.response.headers.get(\"Content-Type\");\n    console.log(\"Content-Type is: \"+contentType);\n});\n\n// Using hardcoded values or environment variables that match the request payload\n// Since the request body isn't visible here, we use the values seen in the response\nvar fname = pm.environment.get(\"fname\");\npm.test(\"Validate JSON data\",()=>{\n    pm.expect(jsonData.booking.firstname).to.eql(fname); \n    console.log(\"Firstname is: \",jsonData.booking.firstname);\n    \n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
